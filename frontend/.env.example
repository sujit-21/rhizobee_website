# ===================================================
# RHIZOBEE INNOVATIONS - FRONTEND ENVIRONMENT EXAMPLE
# ===================================================
# Duplicate this file as .env and update values accordingly

# Application Information
VITE_APP_NAME="Rhizobee Innovations"
VITE_APP_TAGLINE="Secure Payments. Smart Solutions."
VITE_APP_URL="http://localhost:3000"

# Development Server Port
VITE_PORT=3000

# Backend API Endpoint & Target
VITE_API_URL="/api"
VITE_BACKEND_URL="http://localhost:5000"

# Company Contact & Support Details
VITE_CONTACT_EMAIL="info@rhizobee.com"
VITE_SUPPORT_EMAIL="support@rhizobee.com"
VITE_CAREERS_EMAIL="careers@rhizobee.com"
VITE_CONTACT_PHONE="+91 11 4567 8900"

# External Portals
VITE_ZOOMPE_URL="https://www.zoompe.in"

# Deployment Environment
VITE_ENV="development"
